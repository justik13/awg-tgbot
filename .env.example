# Telegram Bot Configuration
API_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_ID=123456789

# Server Configuration
SERVER_NAME=My VPN
SERVER_PUBLIC_KEY=your_server_public_key_here
SERVER_IP=your.server.ip:51820
PUBLIC_HOST=your.server.ip

# AmneziaWG Configuration
DOCKER_CONTAINER=amnezia-wg
WG_INTERFACE=awg0
VPN_SUBNET_PREFIX=10.0.0
FIRST_CLIENT_OCTET=2
MAX_CLIENT_OCTET=254
CONFIGS_PER_USER=5

# Database
DB_PATH=/opt/amnezia/bot/runtime/vpn_bot.db

# Download URL for client apps
DOWNLOAD_URL=https://amnezia.org/en/download/

# Support contact (Telegram username)
SUPPORT_USERNAME=@support

# Pricing in Telegram Stars
STARS_PRICE_7_DAYS=21
STARS_PRICE_30_DAYS=60
STARS_PRICE_90_DAYS=140

# Encryption secret for sensitive data
ENCRYPTION_SECRET=generate_with_openssl_rand_hex_32

# DNS servers for clients
PRIMARY_DNS=8.8.8.8
SECONDARY_DNS=8.8.4.4

# Client configuration
CLIENT_MTU=1420
PERSISTENT_KEEPALIVE=25
CLIENT_ALLOWED_IPS=0.0.0.0/0

# AWG obfuscation settings (auto-detected or manual)
AWG_JC=
AWG_JMIN=
AWG_JMAX=
AWG_S1=
AWG_S2=
AWG_S3=
AWG_S4=
AWG_H1=
AWG_H2=
AWG_H3=
AWG_H4=
AWG_I1=1
AWG_I2=2
AWG_I3=3
AWG_I4=4
AWG_I5=5
AWG_PROTOCOL_VERSION=1
AWG_TRANSPORT_PROTO=udp

# Rate limiting and cooldowns
PURCHASE_CLICK_COOLDOWN_SECONDS=5
PURCHASE_RATE_LIMIT_TTL_SECONDS=60
USER_REISSUE_COOLDOWN_SECONDS=300
ADMIN_COMMAND_COOLDOWN_SECONDS=3

# Docker settings
DOCKER_RETRIES=3
DOCKER_RETRY_BASE_DELAY=1.0
DOCKER_TIMEOUT_SECONDS=30

# AWG helper policy
AWG_HELPER_PATH=/usr/local/libexec/awg-bot-helper
AWG_HELPER_USE_SUDO=1
AWG_HELPER_POLICY_PATH=/etc/awg-bot-helper.json
AWG_PEERS_CACHE_TTL_SECONDS=5.0

# Key and subscription management
PENDING_KEY_TTL_SECONDS=300
PAYMENT_RETRY_DELAY_SECONDS=60
PAYMENT_PROVISIONING_LEASE_SECONDS=300
PAYMENT_MAX_ATTEMPTS=3

# Broadcast settings
BROADCAST_BATCH_SIZE=10
BROADCAST_BATCH_DELAY_SECONDS=0.5
BROADCAST_RUNNING_STALE_SECONDS=300

# Reconciliation and cleanup
RECONCILIATION_INTERVAL_SECONDS=60
CLEANUP_INTERVAL_SECONDS=300

# Referral system
REFERRAL_ENABLED=1
REFERRAL_INVITEE_BONUS_DAYS=3
REFERRAL_INVITER_BONUS_DAYS=3
REFERRAL_RECURRING_INVITER_BONUS_DAYS=1
REFERRAL_RECURRING_MIN_PURCHASE_DAYS=30

# Egress denylist (traffic filtering)
EGRESS_DENYLIST_ENABLED=1
EGRESS_DENYLIST_MODE=soft
EGRESS_DENYLIST_REFRESH_MINUTES=30
EGRESS_DENYLIST_DOMAINS=example.com,blocked.site
EGRESS_DENYLIST_CIDRS=10.0.0.0/8,192.168.0.0/16

# Torrent policy text
TORRENT_POLICY_TEXT_ENABLED=1

# Node API Port (multi-server synchronization)
# Порт для внутреннего HTTPS API нод. Должен быть свободен.
# Если занят другим сервисом — измените на другой порт.
NODE_API_PORT=8444

# Auto-backup settings
AUTO_BACKUP_ENABLED=1
AUTO_BACKUP_KEEP_COUNT=14
