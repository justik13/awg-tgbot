# Telegram Bot Configuration
API_TOKEN=your_bot_token_here
ADMIN_ID=your_admin_id_here

# Server Configuration
SERVER_NAME=My VPN
SERVER_IP=your_public_ip:port
PUBLIC_HOST=your_domain_or_ip
WG_INTERFACE=awg0
DOCKER_CONTAINER=amnezia-awg
SERVER_PUBLIC_KEY=your_wireguard_public_key

# AmneziaWG Obfuscation Settings (optional)
AWG_JC=
AWG_JMIN=
AWG_JMAX=
AWG_S1=
AWG_S2=
AWG_S3=
AWG_S4=
AWG_H1=
AWG_H2=
AWG_H3=
AWG_H4=
AWG_I1=
AWG_I2=
AWG_I3=
AWG_I4=
AWG_I5=

# Database
DB_PATH=runtime/vpn_bot.db

# Security
ENCRYPTION_SECRET=generate_random_secret_here
FERNET_KEY=generate_fernet_key_here

# Prices (Telegram Stars)
STARS_PRICE_7_DAYS=21
STARS_PRICE_30_DAYS=50
STARS_PRICE_90_DAYS=140

# Platega Payment Gateway (optional)
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET_KEY=
PLATEGA_TEST_MODE=1
PLATEGA_WEBHOOK_PORT=8081
PLATEGA_PRICE_7_DAYS=100
PLATEGA_PRICE_30_DAYS=250
PLATEGA_PRICE_90_DAYS=700

# Network Policy
EGRESS_DENYLIST_ENABLED=1
EGRESS_DENYLIST_MODE=soft
EGRESS_DENYLIST_REFRESH_MINUTES=60

# Auto Backup
AUTO_BACKUP_ENABLED=1
AUTO_BACKUP_KEEP_COUNT=14

# Support
DOWNLOAD_URL=https://github.com/amnezia-vpn/amnezia-client/releases/latest
SUPPORT_USERNAME=@support
